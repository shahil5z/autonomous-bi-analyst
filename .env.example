# ---------- Backend (server-side only; never put the OpenAI key in the frontend) ----------
OPENAI_API_KEY=
# Local alternative: path to a file containing the key (raw value or OPENAI_API_KEY=value)
OPENAI_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=12
# Set to 1 to force template explanations
ABI_DISABLE_OPENAI=0
# Allowed browser origins (comma-separated). '*' is rejected at startup.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Abuse protection (in-memory, per server instance)
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=150
# Optional overrides
ABI_DB_PATH=
ABI_DB_GZ_PATH=
ABI_RUNS_DB_PATH=
SQL_MAX_ROWS=500
SQL_TIMEOUT_S=10
# Pipeline: optional path to a local online_retail_II.xlsx (otherwise downloaded from UCI)
ABI_RAW_XLSX=

# ---------- Frontend (build time) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
