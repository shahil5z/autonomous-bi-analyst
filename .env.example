# Backend (never put the OpenAI key in the frontend)
OPENAI_API_KEY=
# Alternative: path to a file containing the key (raw value or OPENAI_API_KEY=value)
OPENAI_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=20
ABI_DISABLE_OPENAI=0
CORS_ORIGINS=http://localhost:3000
# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional backend overrides
ABI_DB_PATH=
ABI_RUNS_DB_PATH=
SQL_MAX_ROWS=
SQL_TIMEOUT_S=
# Pipeline: optional path to a local online_retail_II.xlsx (otherwise downloaded from UCI)
ABI_RAW_XLSX=
